# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT_ID/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Sign-In
# Google Cloud Console > APIs & Services > Credentials
# webClientId: "Web application" tipi OAuth client ID (Supabase paneline de bu girilir)
# iosClientId: "iOS" tipi OAuth client ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Dışa verilen bağlantıların (aile daveti, ileride QR) ve yasal sayfaların https tabanı.
# web/ klasörünün yayınlandığı adres, sondaki / olmadan (GitHub Pages: refill-legal reposu).
# Boşsa geliştirmede Expo'nun kendi derin bağlantısı (exp:// veya refill://) üretilir.
EXPO_PUBLIC_LINK_BASE=https://ymrdgn.github.io/refill-legal

# Paywall'daki "İşletme misiniz? Bize yazın" satırı (boşsa satır gizlenir)
EXPO_PUBLIC_BUSINESS_EMAIL=hello@example.com
